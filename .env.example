# Environment variables for AI Influencer system
# Copy this file to .env and fill in your actual values

# API Keys
OPENAI_API_KEY=your_openai_api_key_here

# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/ai_influencer
REDIS_URL=redis://localhost:6379/0

# Social Media API Keys
INSTAGRAM_ACCESS_TOKEN=your_instagram_access_token
TWITTER_API_KEY=your_twitter_api_key
TWITTER_API_SECRET=your_twitter_api_secret
TWITTER_ACCESS_TOKEN=your_twitter_access_token
TWITTER_ACCESS_TOKEN_SECRET=your_twitter_access_token_secret
TIKTOK_ACCESS_TOKEN=your_tiktok_access_token
YOUTUBE_API_KEY=your_youtube_api_key

# System Settings
DEBUG=false
LOG_LEVEL=INFO

# Content Generation Settings
MAX_CONTENT_PER_DAY=15
DEFAULT_CHARACTER_SEED=42

# Fooocus Settings (if running locally)
FOOOCUS_API_URL=http://localhost:7865
FOOOCUS_API_KEY=optional_api_key

# SadTalker Settings
SADTALKER_MODEL_PATH=./models/sadtalker/

# Monitoring
PROMETHEUS_PORT=8000
